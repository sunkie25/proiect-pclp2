{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-c",
            "type": "shell",

            "command": "taskkill /f /im main.exe /t 2>nul & gcc -Wall -Wextra -g \"${workspaceFolder}\\main.c\" -o \"${workspaceFolder}\\main.exe\" -lfreeglut -lglu32 -lopengl32 && \"${workspaceFolder}\\main.exe\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}